    "rollup": "^4.44.0",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "scripts": {
    "start": "rollup -c --watch --environment DEV",
